<% if @forecast.present? %>
  <div class="bg-white shadow-lg rounded-2xl p-6">
    <!-- City & Date -->
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold"><%= @forecast[:city] %>, <%= @forecast[:state] %> </h1>
      <p class="text-gray-500 text-sm"><%= Date.current.strftime("%A, %B %d") %></p>
    </div>

<% elsif flash[:alert] %>
  <p class="text-red-600 font-semibold mt-4"><%= flash[:alert] %></p>
<% end %>

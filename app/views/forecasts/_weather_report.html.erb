<% if @forecast.present? %>
  <div class="bg-white shadow-lg rounded-2xl p-6">
    <!-- City & Date -->
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold"><%= @forecast[:city] %>, <%= @forecast[:state] %> </h1>
      <p class="text-gray-500 text-sm"><%= Date.current.strftime("%A, %B %d") %></p>
    </div>

    <!-- Current Weather -->
    <div class="flex flex-col items-center mb-6">
      <div class="text-6xl font-bold"><%= @forecast[:current][:temperature] %>°F</div>

      <div class="flex items-center justify-center mt-4">
        <!-- High Temperature -->
        <div class="flex flex-col items-center w-25">
          <p class="text-sm text-gray-500">High</p>
          <p class="text-lg font-semibold text-red-600"><%= @forecast[:today][:high] %>°F</p>
        </div>

        <!-- Low Temperature -->
        <div class="flex flex-col items-center w-25">
          <p class="text-sm text-gray-500">Low</p>
          <p class="text-lg font-semibold text-blue-600"><%= @forecast[:today][:low] %>°F</p>
        </div>
      </div>

      <div class="flex flex-col items-center mt-2">
        <%= weather_icon(@forecast[:current][:description]) %>
        <p class="text-lg text-gray-600 font-bold"><%= @forecast[:current][:description] %></p>
      </div>
    </div>

    <!-- 5 Day Forecast -->
    <%# <div class="grid grid-cols-5 gap-2 text-center text-sm text-gray-700">
      <div class="bg-blue-100 rounded-xl p-2">
        <p class="font-semibold">Wed</p>
        <img src="https://www.weatherbit.io/static/img/icons/c02d.png" class="w-8 h-8 mx-auto" />
        <p>24°C</p>
        <p class="text-xs text-gray-500">18°C</p>
      </div>
      <div class="bg-blue-100 rounded-xl p-2">
        <p class="font-semibold">Thu</p>
        <img src="https://www.weatherbit.io/static/img/icons/r01d.png" class="w-8 h-8 mx-auto" />
        <p>21°C</p>
        <p class="text-xs text-gray-500">17°C</p>
      </div>
      <div class="bg-blue-100 rounded-xl p-2">
        <p class="font-semibold">Fri</p>
        <img src="https://www.weatherbit.io/static/img/icons/s01d.png" class="w-8 h-8 mx-auto" />
        <p>20°C</p>
        <p class="text-xs text-gray-500">15°C</p>
      </div>
      <div class="bg-blue-100 rounded-xl p-2">
        <p class="font-semibold">Sat</p>
        <img src="https://www.weatherbit.io/static/img/icons/c03d.png" class="w-8 h-8 mx-auto" />
        <p>22°C</p>
        <p class="text-xs text-gray-500">16°C</p>
      </div>
      <div class="bg-blue-100 rounded-xl p-2">
        <p class="font-semibold">Sun</p>
        <img src="https://www.weatherbit.io/static/img/icons/c01d.png" class="w-8 h-8 mx-auto" />

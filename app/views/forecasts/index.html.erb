<div class="space-y-6" data-controller="weather">
  <!-- Address Input Form -->
  <%= form_with url: search_forecasts_path, method: :get, local: false,
    data: {
      turbo_stream: true, turbo_frame: "forecast_results",
      action: "submit->weather#showLoading",
      weather_target: "form"
    },
    class: "bg-white p-6 rounded-2xl shadow-md" do |form| %>
    <p class="text-lg font-semibold text-center mb-4">Enter a US address to get the weather from the closest station</p>

    <div class="flex flex-col sm:flex-row gap-3">
      <%= form.text_field :address,
        placeholder: "e.g., 123 Main St, New York",
        required: true,
        class: "flex-1 px-4 py-2 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-400"
      %>

      <%= form.button "Get Forecast",
        class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition duration-200"
      %>
    </div>
  <% end %>

  <!-- Weather Report Section -->
  <turbo-frame id="forecast_results" data-action="turbo:frame-load->weather#hideLoading">
    <div data-weather-target="content" class="hidden">
      <%= render "forecasts/weather_report", forecast: @forecast %>
    </div>
    <div data-weather-target="spinner" class="hidden flex justify-center items-center py-6">
      <div class="animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-blue-600"></div>
    </div>
  </turbo-frame>
</div>
